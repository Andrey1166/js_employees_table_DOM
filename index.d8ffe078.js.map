var form = document.querySelector("form");
form.addEventListener("submit", function(e) {
    e.preventDefault();
    var nameInput = document.querySelector('[name="name"]').value.trim().replace(/[^a-zA-Z]/g, "");
    var position = document.querySelector('[name="position"]').value.trim();
    var age = document.querySelector('[name="age"]').value.trim();
    var office = document.querySelector('[name="office"]').value.replace(/-/g, " ").split(" ").map(function(word) {
        return "".concat(word.charAt(0).toUpperCase() + word.slice(1));
    }).join(" ");
    var salary = document.querySelector('[name="salary"]').value.trim();
    var row = document.createElement("tr");
    if (nameInput.length < 4) {
        pushNotification(10, 10, "Error", "Name must be longer than 4 characters!!!", "error");
        return;
    }
    if (+age < 18 || +age > 90) {
        pushNotification(10, 10, "Error", "Age must be more than 18 and less than 90!!!", "error");
        return;
    }
    if (!position || !office || !salary) {
        pushNotification(10, 10, "Error", "Please fill out all fields with valid values!!!", "error");
        return;
    }
    if (Number.isNaN(+salary) || !Number.isFinite(+salary)) {
        pushNotification(10, 10, "Error", "Please fill out salary field with valid value!!!", "error");
        return;
    }
    var salaryValid = "$".concat((salary / 1000).toFixed(3).toString().replace(".", ","));
    row.innerHTML = "\n  <td>".concat(nameInput, "</td>\n  <td>").concat(position, "</td>\n  <td>").concat(office, "</td>\n  <td>").concat(age, "</td>\n  <td>").concat(salaryValid, "</td>\n  ");
    pushNotification(10, 10, "Success", "New employee added", "success");
    tbody.append(row);
    form.reset();
});
table.tBodies[0].addEventListener("dblclick", function(e) {
    e.preventDefault();
    var td = e.target.closest("td");
    if (!td) return;
    var inputTd = document.createElement("input");
    inputTd.setAttribute("class", "cell-input");
    var text = td.textContent;
    if (!table.tBodies[0].querySelector(".cell-input")) {
        inputTd.setAttribute("name", "cell-input");
        inputTd.value = text;
        td.textContent = "";
        td.append(inputTd);
        inputTd.focus();
    }
    inputTd.addEventListener("blur", function() {
        if (inputTd.value.length > 0) td.textContent = inputTd.value;
        else td.textContent = text;
    });
    inputTd.addEventListener("keydown", function(ev) {
        if (ev.key === "Enter") inputTd.blur();
    });
});

